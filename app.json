{
  "expo": {
    "name": "መጽሐፍ ቅዱስ",
    "slug": "amharic-bible-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F6F1"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F6F1"
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "የጥቅስ ምስሎችን ለማስቀመጥ የምስል መዳረሻ ያስፈልጋል።",
          "savePhotosPermission": "የጥቅስ ምስሎችን ወደ ማዕከለ-ሥዕሎች ለማስቀመጥ።",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-asset",
      "expo-sharing",
      "expo-status-bar",
      "expo-font"
    ]
  }
}
